# Copy to .env and fill in. Standard KEY=VALUE, no "export" prefix.
# Docker Compose reads .env automatically; for a local shell use:
#     set -a; source .env; set +a

FOXESS_API_KEY=

# Your inverter's serial. `zerohero foxess-discover` prints it.
# Required because config.example.yaml sets serial_number: ${FOXESS_SERIAL}
FOXESS_SERIAL=

# Optional, only when forecast.provider: solcast
# SOLCAST_API_KEY=

# Optional: your myaccount.globirdenergy.com.au login, so the controller can read
# GloBird's own daily costs (and whether the ZEROHERO credit was paid) instead of
# you copying them in. Read-only. Set globird.enabled: true in config.yaml too.
GLOBIRD_EMAIL=
GLOBIRD_PASSWORD=
